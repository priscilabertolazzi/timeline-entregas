# Modelo de configuração local. Valores fictícios, apenas para desenvolvimento.
# O script de instalação copia este arquivo para ".env" se ele ainda não existir.
# O arquivo ".env" nunca é versionado: não coloque senhas reais neste modelo.

# Banco de dados (PostgreSQL)
POSTGRES_USER=timeline
POSTGRES_PASSWORD=senha_ficticia_troque_localmente
POSTGRES_DB=timeline_entregas

# Porta do banco no seu computador (o banco só aceita conexões do próprio computador)
DB_PORT=5432

# Portas usadas no seu computador
API_PORT=8080
WEB_PORT=4200

# Fuso horário da API. Sem isso, entre 21h e meia-noite a API consideraria o dia seguinte.
TZ=America/Sao_Paulo

# Dados de exemplo (aplicações Alfa, Beta, Gama e Delta) criados quando o banco está vazio.
# true = carrega; false = não carrega.
SEED_DADOS_EXEMPLO=true

# Endereço do banco para a API (opcional). Sem esta linha, a API usa "localhost".
# DB_HOST=localhost
